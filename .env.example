### Database (or DB_URL=postgres://user:pass@host:5432/db?sslmode=require)
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
#DB_URL=
#DB_SSL_MODE=require
#DB_SSL_CA=/config/ca.pem
#DB_AUTH_DATABASE=postgres
TZ=Europe/Paris

### Dump options
#PG_DUMP_FORMAT=plain
#BACKUP_EXCLUDE_DATABASES=_aiven,defaultdb
#BACKUP_EXCLUDE_TABLES=audit_log

### Database Migration
#TARGET_DB_HOST=
#TARGET_DB_PORT=5432
#TARGET_DB_NAME=
#TARGET_DB_USER=
#TARGET_DB_PASSWORD=
#TARGET_DB_SSL_MODE=
#TARGET_DB_AUTH_DATABASE=postgres

### Backup restoration
#FILE_NAME=

### Storage: local | s3 | gcs | azure | sftp | ftp
#STORAGE=local
#REMOTE_PATH=/backups

### AWS S3 / MinIO
#AWS_S3_ENDPOINT=
#AWS_S3_BUCKET_NAME=
#AWS_REGION=us-east-1
#AWS_ACCESS_KEY=
#AWS_SECRET_KEY=
#AWS_DISABLE_SSL=false
#AWS_FORCE_PATH_STYLE=true

### Schedule and retention
#BACKUP_CRON_EXPRESSION=@midnight
#BACKUP_RETENTION_DAYS=7
#BACKUP_RETENTION_COUNT=10

### SFTP
#SFTP_HOST=
#SFTP_PORT=22
#SFTP_USER=
#SFTP_PASSWORD=
#SFTP_IDENTITY_FILE=/config/id_ed25519
#SFTP_KNOWN_HOSTS=/config/known_hosts

### FTP
#FTP_HOST=
#FTP_PORT=21
#FTP_USER=
#FTP_PASSWORD=

### Azure Blob Storage
#AZURE_STORAGE_CONTAINER_NAME=
#AZURE_STORAGE_ACCOUNT_NAME=
#AZURE_STORAGE_ACCOUNT_KEY=

### Encryption (GPG or age)
#GPG_PASSPHRASE=Your strong passphrase
#GPG_PUBLIC_KEY=/config/gnupg/public_key.asc
#GPG_PRIVATE_KEY=/config/gnupg/private_key.asc
#AGE_RECIPIENTS=age1...
#AGE_IDENTITY_FILE=/config/age/identity.txt

## Multiple databases
#BACKUP_CONFIG_FILE=/config/config.yaml

### Notifications
#BACKUP_REFERENCE=K8s/Paris cluster
#TG_TOKEN=
#TG_CHAT_ID=
#MAIL_HOST=
#MAIL_PORT=587
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_FROM=Backup Jobs <backup-jobs@example.com>
#MAIL_TO=backup@example.com,me@example.com
#MAIL_TLS=starttls
#MAIL_INSECURE_SKIP_VERIFY=false
